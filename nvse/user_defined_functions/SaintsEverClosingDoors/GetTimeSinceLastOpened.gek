begin function { ref rDoor }

	float fTimeLastOpened = Player.RefMapArrayGetFloat "SECD_TimeLastOpenedByDoor" rDoor
	float fCurrentTime = (GetGameDaysPassed 2282 2 10)

	if fTimeLastOpened == 0
		SetFunctionValue -1
		return
	endif

	float fTimeSinceLastOpened = fCurrentTime - fTimeLastOpened
	SetFunctionValue fTimeSinceLastOpened

end