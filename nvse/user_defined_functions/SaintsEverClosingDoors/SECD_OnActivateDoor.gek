begin function { ref rObject, ref rAction }

	; UDFs

	ref MarkTimeLastOpenedUDF = CompileScript "SaintsEverClosingDoors\SECD_MarkTimeLastOpened.gek"

	; Check

	if eval (GetObjectType rObject != 28)
		return
	endif

	; Run

	short bIsDoorOpen = rObject.GetOpenState

	CallAfterFrames 60 (begin function {} 
		short bIsDoorOpenAfterDelay = rObject.GetOpenState
		
		if eval bIsDoorOpenAfterDelay == bIsDoorOpen
			return
		endif

		Call MarkTimeLastOpenedUDF rObject
	end)

end